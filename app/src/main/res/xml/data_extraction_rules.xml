<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de backup y transferencia para Android 12 (API 31) y posteriores.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Decisión (g): se excluyen la base Room y el DataStore tanto del backup en la nube
   como de la transferencia entre dispositivos (ver backup_rules.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="recordatorios.db" />
        <exclude domain="database" path="recordatorios.db-shm" />
        <exclude domain="database" path="recordatorios.db-wal" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="recordatorios.db" />
        <exclude domain="database" path="recordatorios.db-shm" />
        <exclude domain="database" path="recordatorios.db-wal" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
