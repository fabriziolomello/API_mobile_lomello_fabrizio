<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de Auto Backup para Android 11 (API 30) y anteriores.
   En API 31+ se usan las de data_extraction_rules.xml.
   See https://developer.android.com/guide/topics/data/autobackup

   Decisión (g): los datos locales están ligados a la sesión de un usuario.
   No se respaldan la base Room (recordatorios por user_id, pendientes de sync)
   ni el DataStore (hora del último sync, preferencias): restaurarlos en otro
   dispositivo o tras reinstalar podría mostrar datos de una cuenta sin su sesión.
   Los datos del usuario se recuperan desde el remoto al iniciar sesión.
-->
<full-backup-content>
    <!-- Room: AppDatabase.NOMBRE = "recordatorios.db" (más los archivos del modo WAL) -->
    <exclude domain="database" path="recordatorios.db" />
    <exclude domain="database" path="recordatorios.db-shm" />
    <exclude domain="database" path="recordatorios.db-wal" />
    <!-- DataStore: files/datastore/preferencias_usuario.preferences_pb -->
    <exclude domain="file" path="datastore" />
</full-backup-content>
